
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Check if user has an admin role document
    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) && 
             (get(/databases/$(database)/documents/roles_admin/$(request.auth.uid)).data.role == 'admin' || 
              get(/databases/$(database)/documents/roles_admin/$(request.auth.uid)).data.role == 'super_admin');
    }

    function isSuperAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/roles_admin/$(request.auth.uid)).data.role == 'super_admin';
    }

    match /roles_admin/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /settings/general {
      allow read: if true;
      allow write: if isAdmin(); // Temporarily allow Admin for setup, revert to isSuperAdmin for prod
    }

    match /visitors/{visitorId} {
      allow read: if isSignedIn();
      allow write: if true; // Allow tracking
    }

    match /followups/{followupId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Legacy/Service rules
    match /blogPosts/{blogPostId} { allow read: if true; allow write: if isAdmin(); }
    match /services/{serviceId} { allow read: if true; allow write: if isAdmin(); }
    match /pageContents/{pageContentId} { allow read: if true; allow write: if isAdmin(); }
  }
}
